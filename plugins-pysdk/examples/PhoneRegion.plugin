__id__ = "phone_region"
__name__ = "Phone Region"
__author__ = "@tiptop_super7"
__version__ = "1.0"
__description__ = "Показывает страну, ISO-код и флаг номера телефона в меню при зажатии или нажатии на номер в профиле и чатах. Использует официальную базу кодов Telegram."
__min_version__ = "12.10.6"
__icon__ = "UtyaDuckFull/13"

CACHE_FILENAME = "phone_region_countries_v1.json"
CACHE_TTL = 7 * 86400
FOOTER_TAG = "phone_region_footer_v1"

PHONE_PLUS_RE = re.compile(r"(?<!\d)(\+\d[\d\s\-\(\)\u00A0]{5,22}\d)(?!\d)")

FALLBACK_EXTRA_PREFIXES = [
    ("888", "888", "FT", "Anonymous Numbers", "Анонимные номера", True),
    ("76", "7", "KZ", "Kazakhstan", "Казахстан", True),
    ("77", "7", "KZ", "Kazakhstan", "Казахстан", True),
]

DEFAULT_SHARED_PRIORITY = {
    "1": "US",
    "7": "RU",
    "44": "GB",
    "61": "AU",
    "39": "IT",
    "47": "NO",
    "212": "MA",
    "358": "FI",
}


def _iso_to_flag(iso: str) -> str:
    if not iso:
        return "🌐"
    code = str(iso).strip().upper()
    if code == "FT":
        return "🕶"
    if len(code) == 2 and code.isalpha() and code.isascii():
        return chr(0x1F1E6 + ord(code[0]) - ord("A")) + chr(0x1F1E6 + ord(code[1]) - ord("A"))
    return "🌐"


def _digits_only(text: str) -> str:
    return "".join(ch for ch in str(text or "") if ch.isdigit())


def _is_java_instance(obj, cls) -> bool:
    if obj is None or cls is None:
        return False
    try:
        if isinstance(obj, cls):
            return True
    except Exception:
        pass
    try:
        if hasattr(cls, "isInstance") and cls.isInstance(obj):
            return True
    except Exception:
        pass
    return False


def _get_theme_color(key, resources_provider=None):
    try:
        if resources_provider is not None:
            return Theme.getColor(key, resources_provider)
    except Exception:
        pass
    try:
        return Theme.getColor(key)
    except Exception:
        return -1


def _collect_view_texts(view, out, depth=0):
    if view is None or depth > 14:
        return

    try:
        if hasattr(view, "getText"):
            t = view.getText()
            if t is not None:
                s = str(t).strip()
                if s:
                    out.append(s)
    except Exception:
        pass

    has_children = False
    try:
        if hasattr(view, "getChildCount") and hasattr(view, "getChildAt"):
            count = view.getChildCount()
            if count > 0:
                has_children = True
                for i in range(count):
                    _collect_view_texts(view.getChildAt(i), out, depth + 1)
    except Exception:
        pass

    if not has_children:
        for getter in ("getTextView", "getValueTextView", "getSubTextView"):
            try:
                if hasattr(view, getter):
                    child = getattr(view, getter)()
                    if child is not None and child is not view:
                        _collect_view_texts(child, out, depth + 1)
            except Exception:
                pass


def _unique_lower_texts(texts):
    result = []
    seen = set()
    for t in texts:
        s = " ".join(str(t or "").strip().lower().split())
        if s and s not in seen:
            seen.add(s)
            result.append(s)
    return result


def _has_footer_tag(view, depth=0) -> bool:
    if view is None or depth > 14:
        return False
    try:
        if view.getTag() == FOOTER_TAG:
            return True
    except Exception:
        pass
    try:
        if hasattr(view, "getChildCount") and hasattr(view, "getChildAt"):
            for i in range(view.getChildCount()):
                if _has_footer_tag(view.getChildAt(i), depth + 1):
                    return True
    except Exception:
        pass
    return False


def _find_instance_in_tree(view, java_cls, depth=0):
    if view is None or java_cls is None or depth > 12:
        return None
    if _is_java_instance(view, java_cls):
        return view
    try:
        if hasattr(view, "getChildCount") and hasattr(view, "getChildAt"):
            for i in range(view.getChildCount()):
                found = _find_instance_in_tree(view.getChildAt(i), java_cls, depth + 1)
                if found is not None:
                    return found
    except Exception:
        pass
    return None


def _get_primary_popup_layout(view, ab_layout_cls):
    if view is None:
        return None
    try:
        cls_name = str(view.getClass().getSimpleName() or "")
        if "PopupSwipeBackLayout" in cls_name and hasattr(view, "getChildCount") and view.getChildCount() > 0:
            first = view.getChildAt(0)
            if first is not None:
                found = _find_instance_in_tree(first, ab_layout_cls)
                return found or first
    except Exception:
        pass
    return _find_instance_in_tree(view, ab_layout_cls) or view


def _extract_phone_from_texts(texts):
    for raw in texts:
        m = PHONE_PLUS_RE.search(str(raw or ""))
        if m:
            digits = _digits_only(m.group(1))
            if 7 <= len(digits) <= 15:
                return digits
    return None


def _extract_phone_from_cell(cell):
    if cell is None:
        return None

    try:
        pressed = get_private_field(cell, "pressedLink")
        if pressed is not None:
            span = pressed.getSpan() if hasattr(pressed, "getSpan") else pressed
            if span is not None:
                if hasattr(span, "getURL"):
                    url = str(span.getURL() or "").strip()
                    if url.lower().startswith("tel:"):
                        digits = _digits_only(url[4:])
                        if 7 <= len(digits) <= 15:
                            return digits
                    m = PHONE_PLUS_RE.search(url)
                    if m:
                        digits = _digits_only(m.group(1))
                        if 7 <= len(digits) <= 15:
                            return digits

                msg_obj = cell.getMessageObject() if hasattr(cell, "getMessageObject") else get_private_field(cell, "currentMessageObject")
                if msg_obj is not None:
                    for attr in ("messageText", "caption"):
                        seq = getattr(msg_obj, attr, None)
                        if seq is not None and _is_java_instance(seq, Spanned):
                            start = seq.getSpanStart(span)
                            end = seq.getSpanEnd(span)
                            if start >= 0 and end > start:
                                snippet = str(seq.subSequence(start, end))
                                digits = _digits_only(snippet)
                                if 7 <= len(digits) <= 15:
                                    return digits
    except Exception:
        pass

    try:
        msg_obj = cell.getMessageObject() if hasattr(cell, "getMessageObject") else get_private_field(cell, "currentMessageObject")
        if msg_obj is not None:
            candidates = []
            for attr in ("messageText", "caption"):
                val = getattr(msg_obj, attr, None)
                if val is not None:
                    candidates.append(str(val))
            mo = getattr(msg_obj, "messageOwner", None)
            if mo is not None:
                raw_msg = getattr(mo, "message", None)
                if raw_msg:
                    candidates.append(str(raw_msg))
            found = _extract_phone_from_texts(candidates)
            if found:
                return found
    except Exception:
        pass

    return None


class ResetPressedLinkHook(MethodHook):
    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin is None or plugin._unloaded:
            return
        try:
            digits = _extract_phone_from_cell(param.thisObject)
            if digits:
                plugin.remember_phone(digits)
        except Exception:
            pass


class ItemOptionsShowHook(MethodHook):
    def __init__(self, plugin):
        self._plugin_ref = weakref.ref(plugin)

    def before_hooked_method(self, param):
        plugin = self._plugin_ref()
        if plugin is None or plugin._unloaded:
            return
        try:
            plugin.handle_item_options(param.thisObject)
        except Exception:
            pass


